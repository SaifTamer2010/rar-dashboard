# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Every variable below is read by the code — the source is noted in the comment.

# ---------------------------------------------------------------------------
# Database (MongoDB / Mongoose)
# ---------------------------------------------------------------------------

# Mongo connection string. Read by src/lib/mongodb.ts — the app throws on boot without it.
MONGODB_URI="mongodb+srv://user:password@cluster.example.mongodb.net/rar-dashboard"

# ---------------------------------------------------------------------------
# Auth (next-auth v5)
# ---------------------------------------------------------------------------

# Secret next-auth uses to sign/encrypt session JWTs. Read by the framework, not by our code. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# Shared bearer token the cron caller must send as `Authorization: Bearer <value>`. Read by src/app/api/cron/shame-bell/route.ts.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Fallback bot token from @BotFather. Read by src/lib/telegram.ts.
# Each business can store its OWN bot token (set in the owner's settings page,
# kept in the Busniess document); this env value is only used when a business
# has not set one.
TELEGRAM_BOT_TOKEN=""


# NOTE: there is no global chat-id variable. Each TEAM stores its own destination
# chat in `telegram_chat_id` on the Team document, set by the business owner under
# Teams. A team with none falls back to the business-wide `telegram_chat_id`.

# ---------------------------------------------------------------------------
# Pusher (realtime) — server side
# ---------------------------------------------------------------------------

# Pusher app id from the Pusher dashboard. Read by src/lib/pusher-server.ts and src/lib/pusher.ts.
PUSHER_APP_ID=""

# Pusher app key (server copy). Read by src/lib/pusher-server.ts and src/lib/pusher.ts.
PUSHER_KEY=""

# Pusher app secret — server only, never expose to the browser. Read by src/lib/pusher-server.ts and src/lib/pusher.ts.
PUSHER_SECRET=""

# Pusher cluster region, e.g. "eu" or "mt1". Read by src/lib/pusher-server.ts and src/lib/pusher.ts.
PUSHER_CLUSTER=""

# ---------------------------------------------------------------------------
# Pusher — browser side (NEXT_PUBLIC_* is inlined into the client bundle)
# ---------------------------------------------------------------------------

# Same value as PUSHER_KEY, exposed to the browser client. Read by src/lib/pusher-client.ts and src/lib/pusher.ts.
NEXT_PUBLIC_PUSHER_KEY=""

# Same value as PUSHER_CLUSTER, exposed to the browser client. Read by src/lib/pusher-client.ts and src/lib/pusher.ts.
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ---------------------------------------------------------------------------
# Property search (optional)
# ---------------------------------------------------------------------------

# Base URL of the external property-search service. Read by
# src/app/agent/property-search/page.tsx. Leave empty to disable that page.
NEXT_PUBLIC_PROPERTY_SEARCH_URL=""

# ---------------------------------------------------------------------------
# Rate limiting (optional but strongly recommended in production)
# ---------------------------------------------------------------------------

# Upstash Redis, used by src/lib/rate-limit.ts to throttle the public auth
# routes (check-user, sign-up, create-password, join) and credential sign-in.
# With these unset the limiter still runs, but only in-process: the counters are
# per-instance and reset on cold start, so a multi-instance deploy multiplies
# every allowance. Provision Redis before relying on the numbers.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# LEGACY — present in some .env files but read by nothing in src/. Safe to drop.
# ---------------------------------------------------------------------------

# DATABASE_URL   — leftover from a PostgreSQL/Prisma setup. This project is MongoDB + Mongoose; nothing reads it.
# TELEGRAM_SECRET_TOKEN — was only read by the Telegram webhook, which has been removed
#                  along with the /admin/bot inbox.
# TELEGRAM_CHAT_ID — superseded by the per-business `telegram_chat_id` field in MongoDB; nothing reads it.
